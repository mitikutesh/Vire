PRODID:-//Vire//Prep alarm probe//EN
CALSCALE:GREGORIAN
METHOD:PUBLISH
NAME:Vire prep probe
X-WR-CALNAME:Vire prep probe
REFRESH-INTERVAL;VALUE=DURATION:PT1H
X-PUBLISHED-TTL:PT1H
BEGIN:VTIMEZONE
TZID:Europe/Helsinki
BEGIN:STANDARD
DTSTART:19701025T040000
TZOFFSETFROM:+0300
TZOFFSETTO:+0200
RRULE:FREQ=YEARLY;BYMONTH=10;BYDAY=-1SU
TZNAME:EET
END:STANDARD
BEGIN:DAYLIGHT
DTSTART:19700329T030000
TZOFFSETFROM:+0200
TZOFFSETTO:+0300
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=-1SU
TZNAME:EEST
END:DAYLIGHT
END:VTIMEZONE
BEGIN:VEVENT
UID:vire-prep-probe-daily@vire.local
DTSTAMP:20260809T190000Z
DTSTART;TZID=Europe/Helsinki:20260810T203000
DTEND;TZID=Europe/Helsinki:20260810T204000
RRULE:FREQ=DAILY
SUMMARY:Vire probe: before bed, for tomorrow
DESCRIPTION:If an alert reached you 15 minutes before this event, subscribed
  calendars alarm on this device and E7.9 can be built as specced. If you can
  see the event but got no alert, the client stripped the VALARM.
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:Vire probe: this is the alert E7.9 depends on
TRIGGER:-PT15M
END:VALARM
END:VEVENT
