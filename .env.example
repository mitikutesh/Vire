# Copy to .env for local development. Never commit .env.
# Client-side (Vite inlines VITE_* at build time — public values only).

# Leave this UNSET for normal local work: the app then uses the in-memory API and
# everything works offline. Setting it makes the app talk to a real backend, so
# only set it when one is actually running — pointing it at a server that is not
# there makes saving your profile fail with "Couldn't save your profile".
# VITE_API_BASE_URL=http://localhost:3000

# Local sign-up: leave unset and ANY email address may register against the
# in-memory auth fake. Accounts live in the tab and are lost on reload.
# Set this to exercise the real invite-only path locally; a leading @ admits a
# whole domain (e.g. "@visma.com").
# VITE_DEV_ALLOWLIST=you@example.com

# Force the in-memory auth fake in a built (non-dev) bundle. Only needed for
# demo or preview builds; Playwright sets it itself.
# VITE_AUTH_MODE=fake

# Cognito values are injected by SST at deploy time — you do not set them here.
# Google sign-in additionally needs VITE_COGNITO_OAUTH_DOMAIN, and the hosted-UI
# domain plus Google IdP that go with it do not exist yet (BACKLOG E1.3).

# Server-side values are NOT set here — AI provider keys and VAPID keys live in
# AWS SSM and are read by Lambda at runtime (PLAN §3a, §8). Nothing secret
# belongs in a VITE_* variable: it ships to the browser.
