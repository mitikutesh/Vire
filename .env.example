# Copy to .env for local development. Never commit .env.
# Client-side (Vite inlines VITE_* at build time — public values only).
VITE_API_BASE_URL=http://localhost:3000

# Server-side values are NOT set here — AI provider keys and VAPID keys live in
# AWS SSM and are read by Lambda at runtime (PLAN §3a, §8). Nothing secret
# belongs in a VITE_* variable: it ships to the browser.
