# dependencies
node_modules/

# build output
dist/
.vite/
# incremental typecheck caches — machine-local, and they churn on every run
*.tsbuildinfo

# SST / CDK
.sst/
cdk.out/
# Generated by `sst deploy` / `sst dev`; api/sst-env.d.ts is the hand-written
# placeholder that stands in until then.
/sst-env.d.ts

# test artifacts
coverage/
playwright-report/
test-results/
blob-report/
.playwright/

# env & secrets — never commit these
.env
.env.*
!.env.example

# editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# logs
*.log
npm-debug.log*
